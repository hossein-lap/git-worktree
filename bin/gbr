    # exit 0;

}
# }}}

# command wrapper {{{
sub wrapper_cmd {
    my $cmd = $_[0];
    my $err = 0;
    if ($cmd eq "copy" || $cmd eq "move") {
        my $source = shift @ARGV;
        my $destination = shift @ARGV;
        move_handler($source, $destination, $cmd);
    } elsif ($cmd eq "init") {
        sync();
        # init();
    } else {
        print(STDERR "$prompt: $cmd: Invalid command, try --help flag\n");
        exit 2;
    }

}
# }}}

# }}}

# starting point

if ($help) {
    print_help();
    exit($help ? 0 : 1);
}

# handle commands {{{
my $cmd = shift @ARGV;
my $command = 1 if defined $cmd;

if ($cmd) {
    # decide: move command
    wrapper_cmd($cmd);
    exit 0;
}
# }}}

# checking args  {{{
unless ($command) {
    if ($help || !$input) {
        print_help();
        exit($help ? 0 : 1);
    }
}

if ($input =~ /https:/) {
    my $_counter = split(":", $input); # 2: current, 1: none, 3: extra
    my @_tmp = split("/", $input, 4);
    if ($_counter eq 3) {
        $input = "git\@$_tmp[2]/$_tmp[3]";
    } else {
        $input = "git\@$_tmp[2]:$_tmp[3]";
    }
}

unless ($input =~ /git@/) {
    $input = 'git@'.$input;
}

unless ($input =~ /.git$/) {
    $input = $input.'.git';
}

my $_counter = split(":", $input); # 2: current, 1: none, 3: extra
if ($_counter ne 2) {
    if ($_counter eq 1) {
        my @_tmp = split("/", $input, 2);
        $input = "$_tmp[0]:$_tmp[1]";
    }
}

if (!$output) {
    print("No directory name is specified, Using default directory name, ");
    ($output) = $input =~ m{([^/]+)$};
}
# }}}

# define commands {{{

# init {{{
sub init {
    my $ssh_prefix = $sshkey ? "GIT_SSH_COMMAND='ssh -i $sshkey'" : '';
    my $clone_cmd = "$ssh_prefix git clone $args --bare $input $output";
    system($clone_cmd) == 0 or die "$prompt: failed to clone repository\n";
    system("cd $output; git config core.sshCommand 'ssh -i $ssh_prefix'; cd -") if $ssh_prefix;

    chdir $output or die "$prompt: cannot change directory to $output: $!\n";
    mkdir ".bare" or die "$prompt: cannot create .bare directory: $!\n";
    system("mv * .bare") == 0 or die "$prompt: failed to move contents to .bare\n";
    open my $gitfile, '>', '.git' or die "$prompt: cannot open .git file: $!\n";
    print $gitfile "gitdir: ./.bare\n";
    close $gitfile;

    my @branches = `git --no-pager branch`;
    chomp @branches;
    # @branches = grep { $_ !~ /^[*+]/ } @branches;
    @branches = map { s/^\**\s*//r } @branches;

    if (@branches) {
        foreach my $branch (@branches) {
            # print("\$ git worktree add '$branch' '$branch'\n");
            system("git worktree add '$branch' '$branch'") == 0 or print STDERR "$prompt: failed to add worktree for $branch\n";
        }
    }

    # system("git config remote.origin.url 'git@${input}'") == 0 or print STDERR "$prompt: Failed to set origin url\n";
    system("git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'") == 0 or print STDERR "$prompt: failed to set fetch config\n";
    system("git fetch") == 0 or print STDERR "$prompt: failed to fetch from remote\n";
}
# }}}

# sync {{{
sub sync {
    my $path = `git rev-parse --show-toplevel`;
    chomp($path);
    print("$path\n");
}
# }}}

# }}}

