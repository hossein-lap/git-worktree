    my $dest = dirname($_[3]);
    open(INFO, '<' . $path_read) or die "$prompt: Error opening $path_read: $!\n";
    open(OUT, '>' . $path_write) or die "$prompt: Error writing $path_write: $!\n";

    # print("$path_read -> $path_write\n");

    foreach my $line (<INFO>) {

        # chomp($line);

        # # print("i:        $path_read\n");
        # # print("  $line\n");
        # print("$line\n");
        # $line =~ s,$source,$dest,g;
        # print("$line\n");
        # # print("o:        $path_write\n");
        # # print("  $line\n");

        print(OUT "$line");

        # print("I: gitdir: $source\n");
        # print("O: gitdir: $dest\n");

    }
    close(INFO);
    close(OUT);
}
# }}}

# move handler {{{
sub move_handler {
    my $file_source = $_[0];
    my $file_dest = $_[1];
    my $cmd = $_[2];
    $file_dest =~ s,/$,,;
    $file_source =~ s,/$,,;
    my %files = (
        src => {
            base => basename($file_source),
            dir  => dirname($file_source),
        },
        dest => {
            base => basename($file_dest),
            dir  => dirname($file_dest),
        },
        wt => {
            src => {
                dir => $file_source."/.bare/worktrees",
            },
            dest => {
                dir => $file_dest."/.bare/worktrees",
            },
        },
    );

    unless (-d "$file_source/.bare") {
        print(STDERR "$prompt: $cmd: $files{src}{base}: not a valid bare repository\n");
        exit 1;
    }

    my $ready_to_move = 0;
    my $exact_move = 0;
    if (-d "$file_dest") {
        if (-d "$file_dest/$files{dest}{base}") {
            print(STDERR "$prompt: $cmd: $file_dest: file exists\n");
            exit 1;
        } else {
            $ready_to_move = 1;
            $exact_move = 1;
        }
    } else {
        $ready_to_move = 1;
    }

    my $parsed_output_file = $file_dest;
    if ($ready_to_move) {
        if ($exact_move) {
            $parsed_output_file = "$file_dest/$files{src}{base}";
        }
    } else {
        print(STDERR "$prompt: cannot understand given command, try running the script with --help flag\n");
        exit 1;
    }

    if (-f "$parsed_output_file") {
        print(STDERR "$prompt: $cmd: $file_dest: cannot replace a file with directory\n");
        exit 1;
    }

    if ($parsed_output_file eq "$file_dest/$files{src}{base}") {
        if (-d "$parsed_output_file/.bare") {
            print(STDERR "$prompt: $cmd: $file_dest: cannot overwrite an existing repo\n");
        } else {
            print(STDERR "$prompt: $cmd: $file_dest: cannot overwrite an existing directory\n");
        }
        exit 1;
    }

    my $err = 0;
    if ($cmd eq "copy") {
        $err = system("cp", "-r", "$file_source", "$parsed_output_file");
        if ($err eq 0) {
            print("$file_source -> $file_dest\n");
        } else {
            print(STDERR "$prompt: $cmd: command failed\n");
        }
    } elsif ($cmd eq "move") {
        $err = system("mv", "$file_source", "$parsed_output_file");
        if ($err eq 0) {
            print("$file_source -> $file_dest\n");
        } else {
            print(STDERR "$prompt: $cmd: command failed\n");
        }
    } else {
        print(STDERR "$prompt: $cmd: cannot understand given command, try running the script with --help flag\n");
        exit 1;
    }

    # # this is working as intended, just implement the thing
    # # check if the basenames are the same or not
    # if ($files{src}{base} eq $files{dest}{base}) {
    #     print("dirname is included\n");
    # } else {
    #     print("dirname is NOT included\n");
    # }

    exit 0;

    # my $file_dest_dir_bare = $file_dest."/.bare/worktrees";
    # # my $file_dest_dir_worktree = $file_dest."/.bare/worktrees";

    # print("$file_dest_dir_bare\n");
    # print("$file_dest_dir_worktree\n");

    # print("[baredir]\n");
    # my @dirs_bare = dirlist($file_dest_dir_bare);
    # foreach my $dir (@dirs_bare) {
    #     my $branch_name = "$file_dest_dir_bare/$dir";
    #     print("$branch_name\n");
    #     system("cat $branch_name/gitdir");
    #     # fixgitdir("$branch_name/gitdir", $file_source, $file_dest);
    # }
    # print("=========\n");

    # print("\n");

    # my $file_dest_dir_worktree = $file_dest."/.bare/worktrees";

    # print("[worktrees]\n");
    # my @dirs_worktree = dirlist($file_dest);
    # for my $dir (@dirs_worktree) {
    #     my $branch_read = "$file_source/$dir";
    #     my $branch_write = "$file_dest/$dir";
    #     my $expand = ".git";
    # print("=========\n");
    # print("=========\n");
    # print("=========\n");
    #     print("dir: $dir\n");
    #     print("fsr: $file_source\n");
    #     print("fds: $file_dest\n");
    #     print("brr: $branch_read\n");
    #     print("brw: $branch_write\n");
    #     print("exp: $expand\n");
    # print("=========\n");
    # print("=========\n");
    # print("=========\n");
    #     # fixgitdir("$branch_read/$expand", "$branch_write/$expand", $file_source, $file_dest);
    # }
    # print("=========\n");
    #
    # print("[basedir]\n");
    # my @dirs_bare = dirlist($file_dest."/.bare/worktrees");
    # for my $dir (@dirs_bare) {
    #     my $expand = ".bare/worktrees";
    #     my $branch_read = "$file_source/$expand/$dir/gitdir";
    #     my $branch_write = "$file_dest/$expand/$dir/gitdir";
    #     fixgitdir("$branch_read", "$branch_write", $file_source, $file_dest);
    # }
    # print("=========\n");
    #
    # # my @dirs_bare = dirlist($file_dest_dir_worktree);
