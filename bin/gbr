# argument parsing {{{
GetOptions(
    'url=s'      => \$input,
    'dir=s'      => \$output,
    'args=s'     => \$args,
    'action=s'   => \$action,
    'ignore=s@'  => \@ignore,
    'sshkey=s'   => \$sshkey,
    'silent'     => \$silent,
    'h|help'     => \$help,
) or logger("Error in command line arguments. Use -h for help.", 3);
# }}}

# helper functions {{{

# run shell command {{{
sub commander {
    my ($command) = @_;
    my @output = qx($command);
    my $exit_code = $? >> 8;
    chomp @output;
    return (\@output, $exit_code);
}
# }}}

# get list of directories {{{
sub dirlist {
    my $path = $_[0];
    $path =~ s,/$,,;
    # print("dirlist: $path\n");
    # system("ls $path");
    die "$prompt: Please specify which directory to search" unless -d $path;
    my @dirs;
    opendir (my $dir, $path);
    while (my $entry = readdir $dir) {
        next unless -d $path . '/' . $entry;
        next if $entry eq '.' or $entry eq '..';
        # print "\tdirlist: $entry\n";
        unless ($entry =~ /^.bare/) {
            push(@dirs, $entry)
        }
    }
    return @dirs;
    closedir $dir;
}
# }}}

