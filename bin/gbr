# command wrapper {{{
sub wrapper_cmd {
    my $cmd = $_[0];
    my $err = 0;
    if ($cmd eq "copy" || $cmd eq "move") {
        my $source = shift @ARGV;
        my $bare_dir = shift @ARGV;
        move_handler($source, $bare_dir, $cmd);
    } elsif ($cmd eq "init") {
        init($input, $output);
    } elsif ($cmd eq "bulk") {
        bulk($action, @ignore);
    } elsif ($cmd eq "sync") {
        sync(@ignore);
    } else {
        logger("Invalid command: $cmd", 2);
        logger("Try --help flag", 3);
    }

}
# }}}

# url handler {{{
sub url_handler {
    my ($input) = @_;
    if ($input =~ /https:/) {
        my $_counter = split(":", $input); # 2: current, 1: none, 3: extra
        my @_tmp = split("/", $input, 4);
        if ($_counter eq 3) {
            $input = "git\@$_tmp[2]/$_tmp[3]";
        } else {
            $input = "git\@$_tmp[2]:$_tmp[3]";
        }
    }

    unless ($input =~ /git@/) {
        $input = 'git@'.$input;
    }

    unless ($input =~ /.git$/) {
        $input = $input.'.git';
    }

    my $_counter = split(":", $input); # 2: current, 1: none, 3: extra
    if ($_counter ne 2) {
        if ($_counter eq 1) {
            my @_tmp = split("/", $input, 2);
            $input = "$_tmp[0]:$_tmp[1]";
        }
    }
    return $input;
}
# }}}

# }}}

# worker functions {{{

# init {{{
sub init {
    my ($input, $output) = @_;
    my $subname = (caller(0))[3];
    my $url = url_handler($input);
    my $ssh_prefix = $sshkey ? "GIT_SSH_COMMAND='ssh -i $sshkey'" : '';
    my $clone_cmd = "$ssh_prefix git clone $args --bare $input";
    my $oldpath = getcwd;
    my $cmd;

    if ($output && $output ne "") {
        $clone_cmd = "$clone_cmd $output";
    } else {
        ($output) = $input =~ m{([^/]+)$};
    }

    pretty($clone_cmd, 2);
    unless ($output && $output ne "") {
        print("No directory name is specified, Using default directory name, ");
    }
    system($clone_cmd) == 0 or die "$prompt: failed to clone repository\n";

    if ($output && -d $output) {
        if ($ssh_prefix) {
            chdir $output;
            $cmd = "git config core.sshCommand 'ssh -i $ssh_prefix'";
            pretty($cmd, 2);
            system($cmd);
            chdir $oldpath;
        }
    }

    chdir $output or die "$prompt: cannot change directory to $output: $!\n";
    my $bare_dir = '.bare';  # change the .bare directory name if you want
    mkdir $bare_dir or die "$prompt: cannot create .bare directory: $!\n";

    opendir(my $dh, '.') or die "$prompt: failed to open directory: $!\n";
    pretty("mv * $bare_dir", 2);
    while (my $file = readdir($dh)) {
        next if $file eq '.' or $file eq '..' or $file eq $bare_dir;  # Skip current and parent directory entries
        move($file, "$bare_dir/$file") or die "$prompt: failed to move $file to $bare_dir: $!\n";
    }
    closedir($dh);

    open my $gitfile, '>', '.git' or die "$prompt: cannot open .git file: $!\n";
        $cmd = "gitdir: ./$bare_dir";
        pretty("echo '$cmd' > .git", 2);
        print $gitfile $cmd;
    close $gitfile;

    my @branches = `git --no-pager branch`;
    chomp @branches;
    # @branches = grep { $_ !~ /^[*+]/ } @branches;
    @branches = map { s/^\**\s*//r } @branches;

    if (@branches) {
        # pretty("add worktree(s)", 2);
        foreach my $branch (@branches) {
            # print("\$ git worktree add '$branch' '$branch'\n");
            $cmd = "git worktree add '$branch' '$branch'";
            pretty($cmd, 2);
            system($cmd) == 0 or print STDERR "$prompt: failed to add worktree for $branch\n";
        }
    }

    # system("git config remote.origin.url 'git@${input}'") == 0 or print STDERR "$prompt: Failed to set origin url\n";
    $cmd = "git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'";
    pretty($cmd, 2);
    system($cmd) == 0 or print STDERR "$prompt: failed to set fetch config\n";

    $cmd = "git fetch";
    pretty($cmd, 2);
    system($cmd) == 0 or print STDERR "$prompt: failed to fetch from remote\n";
}
# }}}

# sync {{{
sub sync {
    my (@ignore) = @_;
    my $subname = (caller(0))[3];
    my $cmd = "git fetch";

    my $caution = colored(" Caution ", "bold on_red");
    print(STDERR $caution, " Possible data loss ", $caution, "\n");
    print(STDERR "This function will sync your local AND remote repository together\n");
    # print("Are you sure about this? (y/N) ");
    print(STDERR "  Are you sure about this? (y/N) ");
    my $answer = <STDIN>;
    chomp($answer);
    unless ($answer =~ /[yY]/) {
        exit 0;
    }
    print("\n", colored("Running with caution", "bold red"), "\n");
    print("\n");

    # pretty($cmd, 2);
    # system($cmd) == 0 or print STDERR "$prompt: failed to fetch from remote\n";

    my $root_path = `git rev-parse --show-toplevel`;
    chomp($root_path);
    my ($result_ref, $exit_code) = commander("git branch -a");
    my @branchs = @{$result_ref};
    my @branches_remote;
    my @branches_local;
    my @branches_uniq;
    my @branches_all;
    
    foreach my $branch (@branchs) {
        my %hashed;
        $branch =~ s/^..//;
        my @_branch = split(" ", $branch);
        if ($_branch[0] =~ /HEAD/) {
            next;
        }
        if ($_branch[0] =~ /remote/) {
            my @lex = split("/", $_branch[0], 3);
            splice(@lex, 0, 2);
            my $lexed = join("/", @lex);
            %hashed = (name => $lexed, from => "remote");
            push(@branches_remote, \%hashed);
        } else {
            %hashed = (name => $_branch[0], from => "local");
            push(@branches_local, \%hashed);
        }
    }

    # print("local:\n");
    # foreach my $local (@branches_local) {
    #     print("- name: $local->{name}\n");
    #     # print("  from: $local->{from}\n");
    #     # push(@branches_all, $local);
    # }
    #
    # print("remote:\n");
    # foreach my $remote (@branches_remote) {
    #     print("- name: $remote->{name}\n");
    #     # print("  from: $remote->{from}\n");
    #     # push(@branches_all, $remote);
    # }

    my %_branches;
    foreach my $item (@branches_remote, @branches_local) {
        $_branches{ $item->{name} }{ $item->{from} } = 1;
    }
    foreach my $name (sort keys %_branches) {
        my @sources = keys %{ $_branches{$name} };
        if (@sources == 1) {
            my %hashed = (name => $name, from => $sources[0]);
            push(@branches_uniq, \%hashed);
        }
    }

    my $changes_local = 0;
    my $changes_remote = 0;

    # print("uniq:\n");
    foreach my $uniq (@branches_uniq) {
        if ($uniq->{from} eq "remote") {
            $changes_remote++;
        } else {
            $changes_local++;
        }
        # print("- name: $uniq->{name}\n");
        # print("  from: $uniq->{from}\n");
    }
    print("  found $changes_local local changes \n");
    print("  found $changes_remote remote changes \n");
    print("\n");
    print(colored("Proceed...", "bold red"), "\n");
    print("\n");

    # chdir "..";
    # foreach my $branch (@
    # print("$root_path\n");

}
# }}}

# bulk action {{{
sub bulk {
    my ($shell_cmd) = @_;
    my $subname = (caller(0))[3];
    my $msg_prefix = "$subname [worktree] ";
    $msg_prefix = "" if $silent;
    unless ($shell_cmd) {
        logger("No action is specified", 3, $subname);
    }
    my ($result_ref, $exit_code) = commander("git worktree list");
    my @_worktrees = @{$result_ref};
    my @worktrees;
    foreach my $worktree (@_worktrees) {
        if ($worktree =~ /\.bare/) {
            next;
        }
        my @_worktree = split(" ", $worktree);
        push(@worktrees, $_worktree[0]);
    }

    foreach my $worktree (@worktrees) {
        my $skip = 0;

        chdir($worktree);
        my $branch = `git branch --show-current`;
        chomp($branch);
        my $msg_inner = "$branch ";
        $msg_inner = "" if $silent;

        foreach my $ig (@ignore) {
            if ($branch =~ /$ig/) {
                $skip = 1;
            }
        }

        if ($skip) {
            print("$msg_prefix$branch >> skip\n");
        } else {

            my ($result_ref, $exit_code) = commander($shell_cmd);
            my @cmd_output = @{$result_ref};
            foreach my $line (@cmd_output) {
                print("$msg_prefix$msg_inner$line\n");
            }
            # print("\n");
            if ($exit_code) {
                print(STDERR "$msg_prefix $branch (shell returned $exit_code)\n");
            }
        }
        # print("$exit_code\n");
    }
}
# }}}

# }}}

# starting point

if ($help) {
    print_help();
    exit($help ? 0 : 1);
}

# handle commands {{{
my $cmd = shift @ARGV;
my $command = 1 if defined $cmd;

if ($cmd) {
    # decide: move command
    wrapper_cmd($cmd);
    exit 0;
}
# }}}

# checking args  {{{
unless ($command) {
    if ($help || !$input) {
        print_help();
        exit($help ? 0 : 1);
    } else {
        logger("No command is specified", 2);
        logger("Try --help", 3);
    }
}

# }}}

