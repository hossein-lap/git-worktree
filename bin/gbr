# help function {{{
sub print_help {
    print <<"EOF";
setup git worktree and bare repo

usage: $prompt [COMMAND] [OPTIONS]

   • COMMAND
       init            clone the git repository and setup the worktrees
       sync (WIP)      sync all worktrees with the remote (create new ones)
       bulk            run a shell command in all current (active) worktrees
       copy (WIP)      copy a bare repo with its activated worktrees
       move (WIP)      move a bare repo with its activated worktrees

   • OPTIONS
       General:
           --args     extra git arguments
           --help     print this message
           --silent   no extra output (bulk action)
       init:
           --url      repository url        (remote)
           --dir      repository directory  (local)
       bulk:
           --action   the action
           --ignore   ignore worktree

   • EXAMPLE:
       $prompt init --url gitlab.com:hos-workflow/scripts --dir test.git --args '--depth 1'

   • running without any command will show this message
EOF
}
# }}}

# logger {{{
sub logger {
    my ($msg, $level, $name) = @_;
    my ($package, $filename, $line) = caller();
    my $subname = (caller(0))[3];
    my $message;

    if ($name) {
        $subname = $name;
    }

    $message = "] $prompt $subname $line | $msg\n";

    if ($level >= 2) {
        print(STDERR $message);
    } else {
        print(STDOUT $message);
    }
    exit 1 if $level > 2;
}
# }}}

# pretty {{{
sub pretty {
    my ($_msg, $level) = @_;
    # keep=1 so quotes are preserved in tokens
    my @lex = quotewords('\s+', 1, $_msg);
    my @msg;
    my $count = 0;
    for my $key (@lex) {
        # check if token starts and ends with same type of quote
        if ((substr($key, 0, 1) eq '"' && substr($key, -1, 1) eq '"')
           || (substr($key, 0, 1) eq "'" && substr($key, -1, 1) eq "'")) {
            push @msg, colored($key, 'yellow');
            next;
        }
        if ($count == 0) {
            push @msg, colored($key, 'green');
        } elsif ($count <= 2) {
            push @msg, colored($key, 'white');
        } else {
            push @msg, $key;
        }
        $count++;
    }
    my $message = "] @msg\n";
    if ($level == 2) {
        print STDERR $message;
    } else {
        print STDOUT $message;
    }
    exit 1 if $level > 2;
}
# }}}

