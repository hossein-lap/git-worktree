    open(INFO, '<' . $path_read) or die "$prompt: Error opening $path_read: $!\n";
    open(OUT, '>' . $path_write) or die "$prompt: Error writing $path_write: $!\n";

    # print("$path_read -> $path_write\n");

    foreach my $line (<INFO>) {

        # chomp($line);

        # # print("i:        $path_read\n");
        # # print("  $line\n");
        # print("$line\n");
        # $line =~ s,$source,$dest,g;
        # print("$line\n");
        # # print("o:        $path_write\n");
        # # print("  $line\n");

        print(OUT "$line");

        # print("I: gitdir: $source\n");
        # print("O: gitdir: $dest\n");

    }
    close(INFO);
    close(OUT);
}
